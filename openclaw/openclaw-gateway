#!/usr/bin/env bash
# Run the Gateway-bundled OpenClaw CLI so it matches the state database.
# ~/.openclaw/tools/node is the gateway's current Node. Homebrew/npm openclaw
# can be older than that database and will refuse to start.
set -euo pipefail

tools="${OPENCLAW_TOOLS:-$HOME/.openclaw/tools}"
node="${OPENCLAW_NODE:-$tools/node/bin/node}"
entry="${OPENCLAW_ENTRY:-$tools/node/lib/node_modules/openclaw/dist/index.js}"

if [[ -x "$node" && -f "$entry" ]]; then
  exec "$node" "$entry" "$@"
fi

echo "openclaw-gateway: gateway CLI not found at $entry" >&2
echo "Refusing to run Homebrew openclaw; it can be older than the state database." >&2
exit 1
